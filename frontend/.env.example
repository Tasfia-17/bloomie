# Supabase (required for data persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (set to your deployed backend URL, or leave empty to use mock/demo mode)
NEXT_PUBLIC_API_URL=http://localhost:8000

# For Vercel deployment, set NEXT_PUBLIC_API_URL to your backend service URL:
# e.g. https://bloomie-api.railway.app or https://bloomie-api.onrender.com
